# ============================================================
# Damrongdham DCMS — Environment Variables (Docker Compose)
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าก่อนรัน:
#   cp .env.example .env

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=damrongdham_db
MYSQL_USER=damrongdham_user
MYSQL_PASSWORD=your_password_here

# JWT (Backend)
# ควรเปลี่ยนเป็น random string อย่างน้อย 64 ตัวอักษรใน Production
JWT_SECRET=your_jwt_secret_change_to_random_64_chars_in_production

# CORS (Backend)
CORS_ORIGIN=http://localhost:5173

# ============================================================
# LINE Integration (Backend only — ห้าม expose ด้วย VITE_ / ห้าม commit .env จริง)
# ============================================================
# LINE Login Channel (OAuth 2.1 / OpenID Connect)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Callback ต้องตรงกับที่ตั้งใน LINE Developers Console
# Dev: ใช้ public HTTPS tunnel ชี้มา backend เช่น https://<tunnel>/api/citizen/auth/line/callback
LINE_LOGIN_CALLBACK_URL=http://localhost:5001/api/citizen/auth/line/callback

# LINE Messaging API Channel (Official Account) — รับเรื่องผ่านแชต + push notification
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Channel secret ของ Messaging API — ใช้ verify webhook signature (รับเรื่อง/ติดตาม/จับคู่กลุ่มเจ้าหน้าที่)
# Webhook URL ที่ตั้งใน LINE Console: https://<domain-or-tunnel>/api/line/webhook
LINE_MESSAGING_CHANNEL_SECRET=

# ลิงก์ประกาศความเป็นส่วนตัวฉบับเต็มที่แนบไปกับข้อความในแชต
# เว้นว่าง = ใช้หน้า /public/privacy ของระบบเอง
LINE_PRIVACY_NOTICE_URL=

# URLs สำหรับ redirect กลับ frontend หลัง callback + deep link ในข้อความ LINE
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
