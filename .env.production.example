# ============================================================
# Production env (On-premise Docker / Target A) — คัดลอกเป็น .env.production แล้วแก้ค่า
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ⚠️ ห้าม commit .env.production (อยู่ใน .gitignore)
#
# หมายเหตุ: ไฟล์นี้ใช้กับ Target A (Docker) เท่านั้น
# สำหรับ Target B (pm2 + shared server) ให้ตั้งค่าตรงที่ backend/.env และ
# frontend/.env.production แทน — ดูตัวอย่างที่ docs/deployment/DEPLOYMENT.md
# ============================================================

# --- App ---
NODE_ENV=production
PORT=5001

# --- MySQL (Docker Compose) ---
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
MYSQL_DATABASE=damrongdham_db
MYSQL_USER=damrongdham_user
MYSQL_PASSWORD=change_me_strong_password

# --- Backend DB connection (ใช้ชื่อ service 'db' ใน compose network) ---
DB_HOST=db
DB_PORT=3306
DB_USER=damrongdham_user
DB_PASSWORD=change_me_strong_password
DB_NAME=damrongdham_db

# --- Backend / Auth ---
JWT_SECRET=change_me_random_64_chars
JWT_EXPIRES_IN=8h

# --- CORS ---
# ใส่ domain จริงของ server เช่น https://damrongdham.sisaket.go.th
CORS_ORIGIN=https://damrongdham.sisaket.go.th

# --- URLs (ใช้สร้างลิงก์ในข้อความ LINE + redirect หลัง login) ---
FRONTEND_URL=https://damrongdham.sisaket.go.th
BACKEND_URL=https://damrongdham.sisaket.go.th

# --- LINE Login channel (ประชาชน/เจ้าหน้าที่ผูกบัญชี) ---
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=https://damrongdham.sisaket.go.th/api/citizen/auth/line/callback
LINE_LOGIN_BOT_PROMPT=aggressive

# --- LINE Messaging API channel (Official Account) ---
# Webhook URL ที่ตั้งใน LINE Console: https://damrongdham.sisaket.go.th/api/line/webhook
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
# เว้นว่าง = ใช้หน้า /public/privacy ของระบบ
LINE_PRIVACY_NOTICE_URL=
