# ============================================================
# Damrongdham DCMS — Backend Environment Variables
# ============================================================
# สำหรับรัน Backend แบบ standalone หรือใช้เป็น reference สำหรับ Production
# ใน Docker Dev ใช้ environment ใน docker-compose.yml แทน

# Server
NODE_ENV=development
PORT=5001

# MySQL
DB_HOST=db
DB_PORT=3306
DB_USER=damrongdham_user
DB_PASSWORD=your_password_here
DB_NAME=damrongdham_db

# JWT
JWT_SECRET=your_jwt_secret_change_to_random_64_chars_in_production
JWT_EXPIRES_IN=8h

# File Upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:5173

# ============================================================
# LINE (ห้ามใส่ค่าจริงในไฟล์ตัวอย่างนี้ — ตั้งใน backend/.env ที่ gitignore)
# ============================================================
# LINE Login channel
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:5001/api/citizen/auth/line/callback
LINE_LOGIN_BOT_PROMPT=aggressive

# LINE Messaging API channel (Official Account) — รับเรื่องผ่านแชต + แจ้งเตือน
# Webhook URL: https://<domain-or-tunnel>/api/line/webhook
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
# เว้นว่าง = ใช้หน้า /public/privacy ของระบบ
LINE_PRIVACY_NOTICE_URL=

# URLs ที่ใช้สร้างลิงก์ในข้อความ LINE
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
