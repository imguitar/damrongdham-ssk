# ============================================================
# Damrongdham DCMS — Frontend Environment Variables
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า:
#   cp .env.example .env

# Backend API URL
# Dev:  http://localhost:5001/api
# Prod: /api  (same-origin, Express serve frontend เอง)
VITE_API_BASE_URL=http://localhost:5001/api

# App Title (แสดงใน Browser Tab)
VITE_APP_TITLE=ศูนย์ดำรงธรรมจังหวัดศรีสะเกษ (Dev)

# Backend origin สำหรับปุ่ม "เข้าสู่ระบบด้วย LINE" (ต้อง redirect ตรงไป backend
# ให้ OAuth state cookie อยู่ origin เดียวกับ callback)
# Dev: ตั้งเป็น backend/tunnel origin เช่น http://localhost:5001 หรือ https://<tunnel>
# Prod: เว้นว่าง (same origin — Express serve frontend เอง)
VITE_API_ORIGIN=
